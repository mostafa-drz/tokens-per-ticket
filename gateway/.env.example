# Admin key for the proxy. Developers never use this one; issue each of them
# a virtual key instead (see README, "Give each developer a key").
LITELLM_MASTER_KEY=sk-local-master-change-me

# Encrypts provider credentials stored in the database.
# Cannot be rotated after models are added. Set it once.
LITELLM_SALT_KEY=sk-local-salt-change-me

# Upstream provider key the gateway forwards to.
# Optional for the smoke test, which uses the mock model.
ANTHROPIC_API_KEY=

# Shared secret between the gateway plugin and the session registry. Only the
# gateway reads sessions; developers' hooks write key fingerprints, not keys.
TPT_REGISTRY_TOKEN=tpt-local-registry-change-me
