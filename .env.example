# Copy to .env.local. Used by the app and by the pnpm ticket:* scripts.

# Where the ledger reads spend from.
#   sample  = built-in sample data, no gateway needed (default; what the demo deploy uses)
#   litellm = your LiteLLM gateway
LEDGER_DATA=sample

# LiteLLM gateway. The key must read ALL spend on /tag/daily/activity: the
# master key locally, a proxy_admin_viewer key with no-default-models in
# production (README, "Give each developer a key"). A developer's own
# internal_user key answers 200 with only its own spend, so the ledger would
# show partial numbers without an error.
# Server-side only. Never expose it with a NEXT_PUBLIC_ prefix.
LITELLM_BASE_URL=http://localhost:4000
LITELLM_API_KEY=sk-local-master-change-me

# Model the ledger's "Review this ticket's spend" feature calls through LiteLLM.
# Leave empty to hide the feature.
LEDGER_REVIEW_MODEL=
# Budgeted virtual key limited to that model. Falls back to LITELLM_API_KEY,
# which is only right locally.
LEDGER_REVIEW_API_KEY=

# Linear personal API key, only for `pnpm ticket:report --post`.
LINEAR_API_KEY=

# For `report --post` with tracker: jira (Atlassian account email + API token).
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
