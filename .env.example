# Copy to .env.local. Only `pnpm gateway:smoke` and the /ticket-cost skill read these.
LITELLM_BASE_URL=http://localhost:4000

# A key that reads all spend: the master key locally, a proxy_admin_viewer key
# with no-default-models in production (README, "Keys"). A developer's own key
# answers 200 with only its own spend, so figures would be wrong with no error.
LITELLM_API_KEY=sk-local-master-change-me
