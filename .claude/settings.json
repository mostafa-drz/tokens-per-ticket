{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm test:unit)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm lint)",
      "Bash(node .tokens-per-ticket/tpt.mjs report *)",
      "Bash(node .tokens-per-ticket/tpt.mjs start *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.tokens-per-ticket/tpt.mjs\" hook"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.tokens-per-ticket/tpt.mjs\" hook"
          }
        ]
      }
    ],
    "FileChanged": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.tokens-per-ticket/tpt.mjs\" hook"
          }
        ]
      }
    ],
    "CwdChanged": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.tokens-per-ticket/tpt.mjs\" hook"
          }
        ]
      }
    ]
  }
}
