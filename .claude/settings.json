{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(node --import tsx scripts/ticket-report.mts *)",
      "Bash(node --import tsx scripts/ticket-start.mts *)",
      "Bash(pnpm test:unit)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm lint)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/ticket-guard.mjs"]
          }
        ]
      }
    ]
  }
}
