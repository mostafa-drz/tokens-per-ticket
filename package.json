{
  "name": "tokens-per-ticket",
  "version": "0.1.0",
  "private": true,
  "description": "Attribute AI development spend to tickets: Claude Code hooks, a session registry, and a LiteLLM plugin.",
  "license": "MIT",
  "scripts": {
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --import tsx --test tests/unit/*.test.ts",
    "test:registry": "npm --prefix registry ci --silent && npm --prefix registry test",
    "test:gateway": "python3 -m unittest discover -s gateway -p \"test_*.py\"",
    "gateway:up": "docker compose -f gateway/docker-compose.yml up -d",
    "gateway:down": "docker compose -f gateway/docker-compose.yml down",
    "gateway:smoke": "node --import tsx scripts/gateway-smoke.mts",
    "build:cli": "node scripts/build-cli.mjs",
    "tpt": "node --import tsx src/cli/tpt.mts"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "globals": "^17.12.0",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "typescript-eslint": "^8.70.0"
  },
  "packageManager": "pnpm@10.20.0"
}
